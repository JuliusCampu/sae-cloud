function rbac(){return`<div class="card sc"><table class="mx"><thead><tr><th>Rol</th>${MOD.map(m=>`<th>${m}</th>`).join('')}</tr></thead><tbody>${ROL.map((r,i)=>`<tr><td><b>${r}</b></td>${MOD.map((m,j)=>`<td><input type="checkbox" ${RB[i][j]?'checked':''} ${i==0?'disabled':''} onchange="RB[${i}][${j}]=this.checked?1:0"></td>`).join('')}</tr>`).join('')}</tbody></table></div><div class="bar" style="margin-top:16px"><button class="b" onclick="log('Cambio de permisos','RBAC');toast('Permisos actualizados')">Guardar matriz</button><button class="b g" onclick="rol()"><i class="mi">person_add</i>Invitar usuario</button></div>`}
const rol=()=>modal('Invitar usuario','<label>Correo<input id="ie" type="email"></label><label>Rol<select>'+ROL.map(r=>`<option>${r}</option>`).join('')+'</select></label>','Enviar invitación',()=>{if(!$('#ie').value.includes('@')){toast('Correo inválido');return false}log('Invitación','RBAC');toast('Invitación enviada')});
function conf(){return`<div class="card" style="max-width:640px"><label>Nombre de la institución<input value="Instituto SAE Cloud"></label><label>Ciclo escolar<select><option>2025-2026</option><option>2026-2027</option></select></label><label>Fecha límite de captura<input type="date" value="2026-02-18"></label><label>Clave CCT<input value="09PBT0000X"></label><label style="display:flex;gap:10px;align-items:center"><input type="checkbox" checked style="width:18px;margin:0">Timbrado CFDI 4.0 automático</label><button class="b" onclick="log('Cambio de configuración','Configuración');toast('Configuración guardada')">Guardar cambios</button></div>`}